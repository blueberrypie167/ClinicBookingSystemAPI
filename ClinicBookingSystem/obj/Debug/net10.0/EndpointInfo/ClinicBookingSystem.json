  "components": {
    "schemas": {
      "CreateAppointmentDTO": {
        "required": [
          "timeslotId"
        ],
        "type": "object",
        "properties": {
          "timeslotId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateDoctorDTO": {
        "required": [
          "username",
          "specialty"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "specialty": {
            "$ref": "#/components/schemas/Specialty"
          }
        }
      },
      "CreateTimeslotDTO": {
        "required": [
          "starts_At",
          "duration"
        ],
        "type": "object",
        "properties": {
          "starts_At": {
            "type": "string",
            "format": "date-time"
          },
          "duration": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PaginatedDTO": {
        "required": [
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Specialty": {
        "type": "integer"
      },
      "userDTO": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
